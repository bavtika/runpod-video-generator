# AI Video Studio — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# ── LLM (OpenRouter) ──────────────────────────────────────────────
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# ── RunPod (Flux + LTX2) ─────────────────────────────────────────
RUNPOD_API_KEY=
FLUX_ENDPOINT=black-forest-labs-flux-1-dev
LTX2_ENDPOINT=

# ── Custom serverless worker ─────────────────────────────────────
USE_CUSTOM_WORKER=false
RUNPOD_CUSTOM_ENDPOINT=

# ── RunPod S3 (video download) ───────────────────────────────────
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io
RUNPOD_S3_BUCKET=

# ── Optional: fal.ai / Geelark ───────────────────────────────────
FAL_KEY=
GEELARK_API_KEY=
GEELARK_PHONE_ID=

# ── Generation settings ──────────────────────────────────────────
SCENE_COUNT_MIN=5
SCENE_COUNT_MAX=7
FLUX_STEPS=28
FLUX_GUIDANCE=7

# ── Music ────────────────────────────────────────────────────────
BG_MUSIC_DIR=music
BG_MUSIC_VOLUME=0.12
